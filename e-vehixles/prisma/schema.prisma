generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  clerkUserId   String         @unique
  email         String         @unique
  fullName      String?
  phone         String?
  address       String?
  role          UserRole       @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        CustomOrder[]
  inspections   Inspection[]   @relation("UserInspections")
  rentals       Rental[]
  savedVehicles SavedVehicle[]
  vehicles      Vehicle[]
}

model Vehicle {
  id                   Int               @id @default(autoincrement())
  title                String
  type                 VehicleType
  make                 String
  model                String
  year                 Int
  price                Float
  description          String?
  mileage              Int?
  color                String?
  fuelType             FuelType?
  transmission         TransmissionType?
  engineType           EngineType?
  seatingCapacity      Int?
  imageUrl             String?
  isForSale            Boolean           @default(true)
  isForRent            Boolean           @default(false)
  isVerified           Boolean           @default(false)
  status               VehicleStatus     @default(AVAILABLE)
  condition            VehicleCondition? // 👈 Added
  location             NigerianState?    // 👈 Added
  userId               Int
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  featured             Boolean?
  bodyType             String?
  Vehicle_Owner_Name   String?           @map("Vehicle Owner Name")
  Vehicle_owner_Number String?           @map("Vehicle owner Number")
  Vehicle_owner_Email  String?           @map("Vehicle owner Email")
  customOrders         CustomOrder[]
  inspections          Inspection[]
  rentals              Rental[]
  savedByUsers         SavedVehicle[]
  owner                User              @relation(fields: [userId], references: [id])
  images               VehicleImage[]
}

model VehicleImage {
  id        Int     @id @default(autoincrement())
  vehicleId Int
  url       String
  isPrimary Boolean @default(false)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
}

model Rental {
  id         Int          @id @default(autoincrement())
  vehicleId  Int
  userId     Int
  startDate  DateTime
  endDate    DateTime
  status     RentalStatus @default(RESERVED)
  totalPrice Float
  createdAt  DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id])
  vehicle    Vehicle      @relation(fields: [vehicleId], references: [id])
}

model SavedVehicle {
  userId    Int
  vehicleId Int
  savedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])

  @@id([userId, vehicleId])
}

model Inspection {
  id          Int              @id @default(autoincrement())
  vehicleId   Int
  inspectorId Int
  status      InspectionStatus @default(SCHEDULED)
  date        DateTime
  notes       String?
  rating      Int?
  createdAt   DateTime         @default(now())
  inspector   User             @relation("UserInspections", fields: [inspectorId], references: [id])
  vehicle     Vehicle          @relation(fields: [vehicleId], references: [id])
}

model CustomOrder {
  id         Int                 @id @default(autoincrement())
  userId     Int
  vehicleId  Int
  status     CustomizationStatus @default(DRAFT)
  totalCost  Float
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  user       User                @relation(fields: [userId], references: [id])
  vehicle    Vehicle             @relation(fields: [vehicleId], references: [id])
  selections CustomSelection[]
}

model CustomOption {
  id          Int               @id @default(autoincrement())
  name        String
  category    CustomCategory
  basePrice   Float
  isAvailable Boolean           @default(true)
  createdAt   DateTime          @default(now())
  selections  CustomSelection[]
}

model CustomSelection {
  id        Int          @id @default(autoincrement())
  orderId   Int
  optionId  Int
  extraCost Float        @default(0.0)
  notes     String?
  option    CustomOption @relation(fields: [optionId], references: [id])
  order     CustomOrder  @relation(fields: [orderId], references: [id])

  @@unique([orderId, optionId])
}

model DealershipInfo {
  id          Int           @id @default(autoincrement())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  userId      Int           @unique
  WorkingHour WorkingHour[]
}

model WorkingHour {
  id             Int            @id @default(autoincrement())
  dayOfWeek      DayOfWeek
  openTime       String
  closeTime      String
  isOpen         Boolean        @default(true)
  dealershipId   Int
  DealershipInfo DealershipInfo @relation(fields: [dealershipId], references: [id])
}

enum UserRole {
  USER
  ADMIN
}

enum VehicleType {
  CAR
  TRUCK
  MOTORCYCLE
  BOAT
  KEKE
  CONSTRUCTION
  OTHER
}

enum EngineType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  CNG
}
enum VehicleCondition {
  NEW
  USED
  FOREIGN_USED
  LOCAL_USED
}

enum NigerianState {
  ABIA
  ADAMAWA
  AKWA_IBOM
  ANAMBRA
  BAUCHI
  BAYELSA
  BENUE
  BORNO
  CROSS_RIVER
  DELTA
  EBONYI
  EDO
  EKITI
  ENUGU
  FCT
  GOMBE
  IMO
  JIGAWA
  KADUNA
  KANO
  KATSINA
  KEBBI
  KOGI
  KWARA
  LAGOS
  NASARAWA
  NIGER
  OGUN
  ONDO
  OSUN
  OYO
  PLATEAU
  RIVERS
  SOKOTO
  TARABA
  YOBE
  ZAMFARA
}


enum TransmissionType {
  MANUAL
  AUTOMATIC
  SEMI_AUTOMATIC
}

enum VehicleStatus {
  AVAILABLE
  SOLD
  RENTED
  MAINTENANCE
}

enum RentalStatus {
  RESERVED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InspectionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CustomizationStatus {
  DRAFT
  SUBMITTED
  COMPLETED
  CANCELLED
}

enum CustomCategory {
  COLOR
  WHEELS
  INTERIOR
  PERFORMANCE
  OTHER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
